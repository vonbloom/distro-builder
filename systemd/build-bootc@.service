[Unit]
Description=Build the %i bootc image and push it to the registry
After=network-online.target remote-fs.target distro-registry.service
# Wants, not Requires: bootc/prune restarts the registry, which would stop a requiring unit
Wants=network-online.target distro-registry.service
RequiresMountsFor=/mnt/repo
# notify-failure@ comes from the homelab repo (notify_ha role)
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
# Bring the checkout up to date first (fast-forward only). A failed pull (GitHub down, local
# changes) does not stop the build: it runs with the code already there.
ExecStartPre=-/usr/bin/flock /run/distro-builder-git.lock /usr/sbin/runuser -u admin -- git -C /home/admin/distro-builder pull --ff-only
# One build at a time with the other builds (memory, see build-aur.service). prune too: its garbage
# collection must not run during another recipe's push. Both under one lock: with prune in its own
# flock, a queued build took the lock in between and this unit waited for it, shown as running
ExecStart=/home/admin/distro-builder/lib/retry-once %n /home/admin/distro-builder/lib/build-lock /bin/sh -c '/home/admin/distro-builder/bootc/build "$$1" && /home/admin/distro-builder/bootc/prune "$$1"' sh %i
ExecStartPost=/usr/bin/env REPO_PATH=/mnt/repo/bootc/%i KIND=bootc /home/admin/distro-builder/image/notify-image %i
TimeoutStartSec=6h
# A failed build is retried once, half an hour later and without the lock in between (a mirror or
# a registry that failed for a while; the retry pulls the checkout again); notify-failure@ only
# reports the retry's failure (lib/retry-once)
Restart=on-failure
RestartSec=30min
RestartMode=direct
RestartPreventExitStatus=99
