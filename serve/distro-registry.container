[Unit]
Description=Container registry for the bootc images (build-bootc@<recipe>)
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/repo

[Container]
Image=docker.io/library/registry:2
# Pulled and restarted by podman-auto-update.timer when a new image is published
AutoUpdate=registry
# bootc/prune runs garbage-collect in it by name
ContainerName=distro-registry
# Plain HTTP on the LAN: clients list it as insecure (registries.conf.d in the base layer of the bootc
# images, bootc/layers/base, and in the generic overlay of the arkdep recipes)
PublishPort=5000:5000
# bootc/prune deletes old images through the API
Environment=REGISTRY_STORAGE_DELETE_ENABLED=true
Volume=/mnt/repo/registry:/var/lib/registry:Z
# Restart on a failing storage: the registry then answers 503 to everything. The bind mount of a
# subdirectory of the NFS mount can go stale for good ("Stale file handle", mergerfs on zeus forgot
# the directory, 2026-10-17) and only a new container mounts it again. Killed, systemd restarts it
HealthCmd=wget -q -O /dev/null http://127.0.0.1:5000/v2/
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=kill

[Service]
Restart=always

[Install]
WantedBy=default.target
