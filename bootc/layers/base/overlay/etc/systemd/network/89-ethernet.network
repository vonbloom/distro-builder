# SPDX-License-Identifier: MIT-0
#
# This example config file is installed as part of systemd.
# It may be freely copied and edited (following the MIT No Attribution license).
#
# To use the file, one of the following methods may be used:
# 1. add a symlink from /etc/systemd/network to the current location of this file,
# 2. copy the file into /etc/systemd/network or one of the other paths checked
#    by systemd-networkd and edit it there.
# This file should not be edited in place, because it'll be overwritten on upgrades.

# Enable DHCPv4 and DHCPv6 on all physical ethernet links
[Match]
Kind=!*
Type=ether

[Network]
DHCP=yes

# Prefer Ethernet (the dock) over Wi-Fi: lower metric than 80-wifi.network, whose default route
# stays as a ready fallback
[DHCPv4]
RouteMetric=100
# The MAC as DHCP client identifier, not the default DUID made from the machine-id: that one
# changes with every install (and every arkdep deployment), and the address with it
ClientIdentifier=mac

[IPv6AcceptRA]
RouteMetric=100
