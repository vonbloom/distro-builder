#!/usr/bin/env bash
# Saves a pass entry (rofi), opened by $mod+Shift+p: its name (domain/user or app/user), the user
# and the password (generated, from the clipboard or typed twice), in the format secret-menu reads:
# the password on the first line, "login: <user>", and "url: https://<domain>" when the name
# starts with a domain. The new password is then copied (pass -c, cleared after 45 s) to paste into
# the sign-up or change form. pass commits every change when the store is a git repository; the
# push to its remote runs in the background.

set -uo pipefail

store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
LENGTH=25
GENERATE=󰁨 PASTE=󰆒 TYPE=󰌌

menu() { # menu <prompt> <entries...>
	printf '%s\n' "${@:2}" | rofi -dmenu -i -no-custom -p "$1"
}

confirm() {
	[[ $(menu "$1?" "Sí" "No") == "Sí" ]]
}

fail() {
	notify-send "Contrasenyes" "$1"
	exit 1
}

generate() { # generate <tr character set>: as pass generate does
	local password
	read -r -n "$LENGTH" password < <(LC_ALL=C tr -dc "$1" </dev/urandom)
	printf '%s' "$password"
}

[[ -f $store/.gpg-id ]] || fail "No hi ha cap magatzem: pass init <clau GPG>"

# The name. The first-level folders are offered: Enter on one asks again with it filled in, to add
# the user; a name not in the list is taken as typed
name=""
while :; do
	name=$(find "$store" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -printf '%f/\n' | sort |
		rofi -dmenu -i -p "Nova entrada (domini/usuari)" -filter "$name") || exit 0
	name=$(sed 's/^[[:space:]]*//; s/[[:space:]]*$//' <<<"$name")
	[[ $name == */ ]] || break
done
[[ -n $name && $name != /* && $name != *..* ]] || fail "Nom no vàlid: $name"
if [[ -e $store/$name.gpg ]]; then
	confirm "$name ja existeix: la substitueixes" || exit 0
fi

# The user: by default the last part of a domain/user name
default=""
[[ $name == */* ]] && default=${name##*/}
login=$(printf '%s\n' "$default" | rofi -dmenu -i -p "Usuari") || exit 0

choice=$(menu "Contrasenya" \
	"$GENERATE  Genera'n una ($LENGTH caràcters, amb símbols)" \
	"$GENERATE  Genera'n una ($LENGTH caràcters, sense símbols)" \
	"$PASTE  La del porta-retalls" \
	"$TYPE  Escriu-la") || exit 0

case $choice in
*"amb símbols"*) password=$(generate '[:punct:][:alnum:]') ;;
*"sense símbols"*) password=$(generate '[:alnum:]') ;;
"$PASTE"*) password=$(wl-paste --no-newline 2>/dev/null) ;;
"$TYPE"*)
	password=$(rofi -dmenu -password -p "Contrasenya" </dev/null) || exit 0
	again=$(rofi -dmenu -password -p "Repeteix-la" </dev/null) || exit 0
	[[ $password == "$again" ]] || fail "Les contrasenyes no coincideixen"
	;;
*) exit 0 ;;
esac
[[ -n $password ]] || fail "La contrasenya és buida"

url=""
domain=${name%%/*}
[[ $name == */* && $domain == *.* ]] && url="https://$domain"

# if, not &&: a false test as the group's last command would fail the pipeline (pipefail)
{
	printf '%s\n' "$password"
	if [[ -n $login ]]; then printf 'login: %s\n' "$login"; fi
	if [[ -n $url ]]; then printf 'url: %s\n' "$url"; fi
} | pass insert -m -f "$name" >/dev/null || fail "No s'ha pogut desar $name"

if [[ -n $(git -C "$store" remote 2>/dev/null) ]]; then
	(pass git push -q >/dev/null 2>&1 || notify-send "Contrasenyes" "No s'ha pogut pujar el magatzem al remot") &
fi

if pass show -c "$name" >/dev/null; then
	notify-send "Contrasenyes" "Desada: $name. Contrasenya copiada (s'esborra en 45 s)"
else
	notify-send "Contrasenyes" "Desada: $name"
fi
