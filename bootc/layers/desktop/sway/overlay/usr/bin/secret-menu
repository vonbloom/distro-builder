#!/usr/bin/env bash
# Password menu (rofi), opened by $mod+p: pick a pass entry, then type it into the window that had
# the focus (wtype) or copy it. Entries are the domain/user or app/user files of the pass store
# (pass: workstation module): the password on the first line, then "login: <user>" and
# "url: <url>", the format secret-save writes. Nothing presses Enter: the form is sent by hand. In
# Brave nothing checks the page's domain: look at the address bar before typing. gpg-agent asks
# for the key's passphrase (pinentry-gtk) when it is not cached. The secrets go to wtype on its
# stdin, never as arguments (any process can read those in /proc).

set -uo pipefail

store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
BOTH=󰌌 PASSWORD=󰌋 USER=󰀄 COPY=󰆏

menu() { # menu <prompt> <entries...>
	printf '%s\n' "${@:2}" | rofi -dmenu -i -no-custom -p "$1"
}

type_text() { # type_text: the text on stdin, typed into the focused window
	# -s: rofi has just closed, the window that had the focus gets it back first
	wtype -s 150 -
}

if [[ ! -f $store/.gpg-id ]]; then
	notify-send "Contrasenyes" "No hi ha cap magatzem: pass init <clau GPG>"
	exit 1
fi

entry=$(find "$store" -name '*.gpg' -printf '%P\n' | sed 's/\.gpg$//' | sort |
	rofi -dmenu -i -no-custom -p "Contrasenya") || exit 0

secret=$(pass show "$entry") || {
	notify-send "Contrasenyes" "No s'ha pogut desxifrar $entry"
	exit 1
}
password=$(head -n 1 <<<"$secret")
login=$(sed -n 's/^login:[[:space:]]*//p' <<<"$secret" | head -n 1)

actions=()
[[ -n $login ]] && actions+=("$BOTH  Escriu l'usuari i la contrasenya")
actions+=("$PASSWORD  Escriu la contrasenya")
[[ -n $login ]] && actions+=("$USER  Escriu l'usuari")
actions+=("$COPY  Copia la contrasenya (45 s)")

choice=$(menu "$entry" "${actions[@]}") || exit 0

case $choice in
"$BOTH"*)
	printf '%s' "$login" | type_text
	wtype -k Tab
	printf '%s' "$password" | wtype -
	;;
"$PASSWORD"*) printf '%s' "$password" | type_text ;;
"$USER"*) printf '%s' "$login" | type_text ;;
"$COPY"*) pass show -c "$entry" >/dev/null ;;
esac
