[Unit]
Description=Userland provisioning
# The user's dotfiles and boxes, not root's or a system user's: enabled for every user manager
# (--global preset), it made an SSH login as root (bootc/test) clone the dotfiles and pull the
# userland image, and the login waited for it (a oneshot that default.target waits for)
ConditionUser=!@system
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/deploy-userland
ExecStartPre=/usr/bin/sleep 1
# Prioritat de CPU mínima (19 és la més baixa)
Nice=19
# Només utilitza la CPU si ningú més la necessita
CPUSchedulingPolicy=idle
# Prioritat d'entrada/sortida de disc mínima
IOSchedulingClass=idle

[Install]
WantedBy=default.target
