#!/usr/bin/env bash
# Usage: test [--from <previous image>] <image>
# Boot test of a bootc image, run by bootc/build before latest names it, in a throwaway VM (QEMU
# with KVM and OVMF, NAT networking that reaches the registry).
# - test <image>: what a new install does. The image is pulled from the registry with the
#   clients' signature policy (a missing or bad signature, or a missing blob, fails here like on
#   the T480), installed on a sparse disk image like bootc/install does (composefs backend,
#   systemd-boot, ext4 with fs-verity) and booted.
# - test --from <previous> <image>: what the clients do with an update. <previous> (latest: what
#   they run) is installed and booted, given local state like a real machine's (a user, the
#   hostname, an image file edited, a port opened with fw, a file in /var), switched to <image>
#   with bootc switch (pulled inside the VM, with the clients' policy: the update path itself) and
#   rebooted. It must boot <image>, keep the local state, and keep <previous> as the rollback.
# Each boot passes when the system answers over SSH and reaches "running" (no failed unit) and the
# journal, forwarded to the serial console, shows no failure line, within BOOT_TIMEOUT seconds.
# root gets a throwaway SSH key at the install (bootc install --root-ssh-authorized-keys). It does
# not test hardware drivers (GPU, Wi-Fi) or the desktop.
# The serial log goes to BOOT_LOG (default: the work directory, deleted afterwards). Needs root,
# /dev/kvm (VM 202: cpu host, homelab host_vars/zeus.yml), qemu-system-x86, ovmf and ssh.
# Local test runs (no signing key, the image unsigned): ALLOW_UNSIGNED=1, and on Arch
# OVMF_CODE=/usr/share/edk2/x64/OVMF_CODE.4m.fd OVMF_VARS=/usr/share/edk2/x64/OVMF_VARS.4m.fd
# (--from needs signed images: bootc switch in the VM checks them)

set -euo pipefail

cd "$(dirname "$(readlink -f "$0")")/.."

FROM=''
if [[ ${1:-} == --from ]]; then
	FROM=${2:?--from needs an image reference}
	shift 2
fi
IMAGE=${1:?An image reference must be specified}
INSTALL=${FROM:-$IMAGE}
BOOT_TIMEOUT=${BOOT_TIMEOUT:-600}
SSH_PORT=${SSH_PORT:-10022}
OVMF_CODE=${OVMF_CODE:-/usr/share/OVMF/OVMF_CODE_4M.fd}
OVMF_VARS=${OVMF_VARS:-/usr/share/OVMF/OVMF_VARS_4M.fd}
# Lines of the serial log that fail the test. Units that fail in a VM without the hardware they
# expect would go to an exception here, never to the image. "FILE CORRUPTED": fs-verity found a
# file of the composefs repository that does not match its digest (until 2026-10-18 left out: the
# root was btrfs, whose fs-verity bug with compressed extents logged it for intact data)
FAILURE='Failed to start|Failed with result|Dependency failed|emergency mode|Emergency Shell|Kernel panic|FILE CORRUPTED'
# Not the lines of user managers (systemd[<pid>] other than 1): the only one here is root's,
# started by the test's own SSH login, whose sway layer units have no business running (pipewire's
# ConditionUser=!root left wireplumber with "Dependency failed"). No user manager runs for root on
# a real machine: root is locked, and sudo starts none
USER_MANAGER='systemd\[(1[0-9]+|[2-9][0-9]*)\]:'

[[ -e /dev/kvm ]] || { echo "No /dev/kvm: the boot test needs KVM" >&2; exit 1; }

# The disk image (~5 GB written of a sparse 20 GB): /var/tmp, not the tmpfs /tmp. Global for the
# EXIT trap
TEST_WORK=$(mktemp -d /var/tmp/bootc-test.XXXXXX)
TEST_QEMU=''
# set +e: a failing command here (the image already removed, qemu's exit status) would otherwise
# become the script's exit status, also after a passed test
cleanup() {
	set +e
	[[ -n $TEST_QEMU ]] && kill "$TEST_QEMU" 2>/dev/null && wait "$TEST_QEMU" 2>/dev/null
	podman rmi "$INSTALL" >/dev/null 2>&1
	rm -rf -- "$TEST_WORK"
	return 0
}
trap cleanup EXIT
work=$TEST_WORK
log=${BOOT_LOG:-$work/serial.log}
: >"$log"

failures() { grep -aE "$FAILURE" "$log" | grep -avE "$USER_MANAGER"; }
fail() {
	echo "Boot test failed${FROM:+ (update from $FROM)}: $*${BOOT_LOG:+; serial log in $BOOT_LOG}" >&2
	failures | tr -d '\r' | head -20 >&2 || true
	echo "--- last lines of the serial log" >&2
	tail -n 40 "$log" | tr -d '\r' >&2
	exit 1
}

# The clients' policy (the base layer's policy.json: signatures required for the build
# server's registry, matchRepository) with the public key of this checkout. The signatures are
# read from the registry as on the clients: /etc/containers/registries.d/50-distro-builder.yaml,
# installed by ../install
pull=(--tls-verify=false)
if [[ ${ALLOW_UNSIGNED:-0} != 1 ]]; then
	sed "s|/etc/pki/containers/distro-builder.pub|$PWD/keys/distro-builder-sigstore.pub|" \
		bootc/layers/base/overlay/etc/containers/policy.json \
		>"$work/policy.json"
	pull+=(--signature-policy "$work/policy.json")
fi
podman pull "${pull[@]}" "$INSTALL"

# The image installs itself from the host's container storage, as from the ISO (bootc/install).
# --generic-image: no firmware boot entry, on the build server's own firmware. The journal goes to
# the serial console: any failure, also after the getty started
ssh-keygen -q -t ed25519 -N '' -C bootc-test -f "$work/key"
truncate -s 20G "$work/disk.raw"
podman run --rm --privileged --pid=host --ipc=host --security-opt label=type:unconfined_t \
	-v /dev:/dev -v /var/lib/containers:/var/lib/containers -v "$work:/work" \
	"$INSTALL" bootc install to-disk --via-loopback --generic-image --composefs-backend \
	--bootloader systemd --filesystem ext4 --karg rootflags=noatime \
	--karg console=ttyS0 --karg systemd.journald.forward_to_console=1 \
	--root-ssh-authorized-keys /work/key.pub /work/disk.raw
podman rmi "$INSTALL" >/dev/null

# No -no-reboot: the update test reboots the VM into the new image. SSH on a port of the loopback
cp "$OVMF_VARS" "$work/vars.fd"
qemu-system-x86_64 -enable-kvm -machine q35 -cpu host -smp 2 -m 3G \
	-drive if=pflash,format=raw,readonly=on,file="$OVMF_CODE" \
	-drive if=pflash,format=raw,file="$work/vars.fd" \
	-drive file="$work/disk.raw",format=raw,if=virtio \
	-nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$SSH_PORT-:22" \
	-display none -serial file:"$log" &
TEST_QEMU=$!

guest() {
	ssh -p "$SSH_PORT" -i "$work/key" -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes \
		-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
		-o ConnectTimeout=5 root@127.0.0.1 "$@"
}

# Wait for a boot other than $1 (the boot ID of the previous one; empty for the first) to answer
# over SSH and finish starting without a failed unit. Over SSH, not "Startup finished" on the
# serial console: its getty writes terminal resets into the middle of the journal's lines
BOOT_ID=''
boot() {
	local previous=$1 elapsed id state
	for ((elapsed = 0; ; elapsed += 5)); do
		((elapsed < BOOT_TIMEOUT)) || fail "no SSH after ${BOOT_TIMEOUT}s"
		kill -0 "$TEST_QEMU" 2>/dev/null || fail "the VM exited"
		if failures >/dev/null; then
			sleep 10 # a few more seconds of log around the failure for the report
			fail "a failure on the serial console"
		fi
		id=$(guest cat /proc/sys/kernel/random/boot_id 2>/dev/null) && [[ $id != "$previous" ]] && break
		sleep 5
	done
	state=$(guest timeout "$BOOT_TIMEOUT" systemctl is-system-running --wait) || true
	if [[ $state != running ]]; then
		guest systemctl --failed --no-legend >&2 || true
		fail "the system is ${state:-unreachable}, not running"
	fi
	BOOT_ID=$id
	echo "Booted $(guest bootc status --format json | python3 -c 'import json,sys; print(json.load(sys.stdin)["status"]["booted"]["image"]["image"]["image"])'):" \
		"$(guest systemd-analyze | head -n 1)"
}

boot ''

if [[ -n $FROM ]]; then
	# A machine's own state: what the 3-way merge of /etc must keep, and /var, which bootc never
	# touches. fw writes /etc/nftables.d/fw.nft and loads it
	guest 'set -e
		useradd -m -u 1000 -s /usr/bin/zsh upgrade-test
		echo upgrade-test >/etc/hostname
		echo "upgrade-test: a local edit" >>/etc/issue
		fw allow 12345 >/dev/null
		mkdir -p /var/lib/upgrade-test && echo kept >/var/lib/upgrade-test/state' ||
		fail "could not give the VM its local state"

	# The digest the update must boot, from the registry the VM pulls it from
	registry=${IMAGE%%/*} ref=${IMAGE#*/}
	digest=$(curl -sfI -H 'Accept: application/vnd.oci.image.manifest.v1+json' \
		"http://$registry/v2/${ref%:*}/manifests/${ref##*:}" |
		sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: *//p' | tr -d '\r')
	[[ -n $digest ]] || fail "no manifest for $IMAGE in the registry"
	guest bootc switch --quiet "$IMAGE" || fail "bootc switch $IMAGE failed"
	guest systemctl reboot || true
	boot "$BOOT_ID"

	problems=()
	check() { guest "$2" >/dev/null 2>&1 || problems+=("$1"); }
	status=$(guest bootc status --format json)
	read -r booted rollback < <(python3 -c '
import json, sys
s = json.load(sys.stdin)["status"]
roll = (s.get("rollback") or {}).get("image") or {}
print(s["booted"]["image"]["imageDigest"], roll.get("image", {}).get("image", "none"))' <<<"$status")
	[[ $booted == "$digest" ]] || problems+=("booted $booted, not $IMAGE ($digest)")
	[[ $rollback == "$FROM" ]] || problems+=("rollback $rollback, not $FROM")
	check "not two boot entries" '[ "$(ls /boot/loader/entries/*.conf | wc -l)" -eq 2 ]'
	check "the hostname lost" '[ "$(cat /etc/hostname)" = upgrade-test ]'
	check "the user lost" 'getent passwd upgrade-test'
	check "the edit of /etc/issue lost" 'grep -q "upgrade-test: a local edit" /etc/issue'
	check "the port opened with fw lost" 'grep -q 12345 /etc/nftables.d/fw.nft && nft list set inet filter allowed_tcp | grep -q 12345'
	check "the file in /var lost" '[ "$(cat /var/lib/upgrade-test/state)" = kept ]'
	((${#problems[@]} == 0)) || fail "after the update: $(printf '%s; ' "${problems[@]}")"
fi

failures >/dev/null && fail "a failure on the serial console"
echo "Boot test passed${FROM:+ (update from $FROM)}"
