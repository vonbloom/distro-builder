# AUR packages to build and publish in the [aur] repository, one per line.
# AUR dependencies are pulled in automatically. Packages built from a local PKGBUILD
# (local/<pkgname>/PKGBUILD, e.g. bootc) must not be listed here.
visual-studio-code-bin
ledger-live-bin
auto-cpufreq
devpod-cli-bin
# corosync-qnetd, the QDevice of a Proxmox cluster run on an Arch machine: pulls in
# corosync, kronosnet and libcgroup (reviewed 2026-10-09: upstream sources with checksums)
corosync-qdevice
# squeezelite, a Lyrion player: built against the current ffmpeg (reviewed
# 2026-10-09: upstream git at a pinned commit)
squeezelite
# The minimal edition of Brave: Brave's own AUR package (reviewed 2026-11-02: the upstream
# release zip with its checksum)
brave-origin-bin
# pandoc without Arch's Haskell libraries (reviewed 2026-11-02: the upstream release binary and
# source tarball, with their checksums)
pandoc-bin
