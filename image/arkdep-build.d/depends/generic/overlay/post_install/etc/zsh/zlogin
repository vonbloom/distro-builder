if [[ -f $HOME/.config/zsh/.zlogin ]]; then
    return
fi
# Only on the first virtual console itself: every process of the graphical session inherits
# XDG_VTNR=1, so a login shell that lost DISPLAY and WAYLAND_DISPLAY (a tmux pane after an attach
# over SSH) would try to start a second sway, fail and close.
if [[ $TTY == /dev/tty1 && -z $DISPLAY && -z $WAYLAND_DISPLAY ]]; then
    exec systemd-cat -t sway sway
fi
