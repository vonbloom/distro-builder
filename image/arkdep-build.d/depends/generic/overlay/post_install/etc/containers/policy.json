{
    "default": [
        {
            "type": "insecureAcceptAnything"
        }
    ],
    "transports":
        {
            "docker":
                {
                    "@SERVER@:5000": [
                        {
                            "type": "sigstoreSigned",
                            "keyPath": "/etc/pki/containers/distro-builder.pub",
                            "signedIdentity": {"type": "matchRepository"}
                        }
                    ]
                },
            "docker-daemon":
                {
                    "": [{"type":"insecureAcceptAnything"}]
                }
        }
}
